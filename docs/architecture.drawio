        <mxCell id="note-db" parent="deployment" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;spacing=6;fontColor=#232F3E;fontStyle=1" value="&lt;span&gt;One relational store holds four kinds of state:&lt;/span&gt; &lt;span style=&quot;font-weight: normal;&quot;&gt;queue, claim, retry and intake.&lt;br&gt;Sweeper, retry jobs and worker threads contend for the same rows.&lt;br&gt;Failed rows stay in the inbox — there is no dead-letter store.&lt;/span&gt;" vertex="1">
